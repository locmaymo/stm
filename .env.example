# Optional manager bootstrap values:
# STM_ADMIN_PASSWORD=

# Where the manager listens (optional). Both are read once, at startup, so a
# change needs a restart. They are deliberately not in the panel: moving the
# port from a page served on it would take that page down with it.
# STM_HOST is the address to bind. 127.0.0.1 is this machine only; 0.0.0.0 is
# every network this machine is on, which is what Docker and ModelScope use by
# default. Set an admin password before opening it to a network.
# STM_HOST=127.0.0.1
# STM_PORT=7860
# The internal door SillyTavern is served through, and what a tunnel publishes.
# STM_ACCESS_PORT=8001
# SillyTavern's own port is changed in the panel instead, because the manager
# has to check it against the two above before anything takes it.

# The address the panel is reached at from outside (optional).
# Set this when the manager runs behind a proxy that rewrites Host, such as a
# reverse proxy or a port forward, so "Connect Cloudflare" comes back to the
# address the browser is on instead of localhost. GitHub Codespaces is detected
# on its own and needs nothing here.
# STM_PUBLIC_ORIGIN=https://example.com

# Signing in to Cloudflare (optional; the defaults work).
# The panel's "Connect Cloudflare" uses the project's public OAuth client and
# its relay page. Set these only to use an OAuth client registered in your own
# Cloudflare account (see deploy/oauth-relay/README.md), or set the client ID
# empty to turn signing in off and use S3 keys only.
# STM_CLOUDFLARE_OAUTH_CLIENT_ID=
# STM_CLOUDFLARE_OAUTH_REDIRECT_URI=https://stm.phamloc.top/oauth/cloudflare/callback
# STM_CLOUDFLARE_OAUTH_SCOPES=workers-r2.read workers-r2.write workers-r2-bucket-item.read workers-r2-bucket-item.write workers-scripts.write account-analytics.read

# Cloudflare R2 backups with S3 keys (optional).
# Every value comes from the R2 page of the Cloudflare dashboard. Anything set
# here is read on each start, shown in the panel, and cannot be changed there.
# With all four set, R2 backups start switched on the first time.
# STM_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STM_R2_BUCKET=
# STM_R2_ACCESS_KEY_ID=
# STM_R2_SECRET_ACCESS_KEY=
