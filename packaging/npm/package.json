{
  "name": "sillytavern-manager",
  "version": "0.1.0",
  "description": "Cross-platform manager for installing, running, backing up, and monitoring SillyTavern.",
  "type": "module",
  "bin": {
    "sillytavern-manager": "cli.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "cli.mjs",
    "apps/manager-server/src/**/*.js",
    "packages/*/src/**/*.js",
    "packages/instrumentation/src/*.mjs",
    "panel/**",
    "node_modules/yaml/**"
  ],
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
