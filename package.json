{
  "name": "sillytavern-manager",
  "private": true,
  "version": "0.1.0",
  "description": "Cross-platform manager for installing, running, backing up, and monitoring SillyTavern.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "encoding:gate": "node scripts/encoding-gate.mjs",
    "lint": "eslint .",
    "manager:start": "node --env-file-if-exists=.env --import tsx apps/manager-server/src/main.ts",
    "panel:dev": "vite --config apps/manager-panel/vite.config.ts",
    "panel:build": "vite build --config apps/manager-panel/vite.config.ts",
    "panel:preview": "vite preview --config apps/manager-panel/vite.config.ts",
    "release:npm": "node scripts/build-npm-package.mjs",
    "release:windows": "node scripts/build-windows-release.mjs",
    "test": "node --import tsx --test",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "npm run encoding:gate && npm run lint && npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.12.1",
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.35.0",
    "node-fetch": "^3.3.2",
    "node-fetch-v2": "npm:node-fetch@^2.7.0",
    "postject": "^1.0.0-alpha.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vite": "^8.2.2"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.43.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yaml": "^2.9.0"
  }
}
